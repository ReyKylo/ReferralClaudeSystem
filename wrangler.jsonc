{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds checks this).
  "name": "referralclaudesystem",
  "compatibility_date": "2026-09-01",
  // `wrangler deploy` / `wrangler versions upload` build the static export first, so Workers Builds needs no build command.
  "build": { "command": "npm run build" },
  // Static assets only (no Worker code): the portal is the out/ folder from `next build`.
  // The domain referral.tampilresmi.com is attached in the dashboard (Settings > Domains & Routes), like the ERP's.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "observability": { "enabled": true }
}
